# Template for the SERVER's .env (copy to .env on the server and fill in the blanks).
# Do not use .env.example on a server: it holds local development values (localhost, debug on).
#
# After any change to .env on the server run:   php artisan optimize
# (the configuration is cached; edits to .env are ignored until you do)

APP_NAME="IT Security Nepal"
APP_ENV=production            # use "staging" on new.itsecuritynepal.com: pages then stay out of Google (noindex)
APP_KEY=                      # filled by: php artisan key:generate
APP_DEBUG=false
APP_URL=https://itsecuritynepal.com   # staging: https://new.itsecuritynepal.com  (no trailing slash)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=                  # cPanel → MySQL Databases (usually cpaneluser_name)
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true    # requires HTTPS
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Email for enquiry notifications (cPanel → Email Accounts → Connect Devices shows these values)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="IT Security Nepal"
ENQUIRY_NOTIFY_EMAIL=
# NEWSLETTER_PER_MINUTE=30      # fallback only; set the speed in Admin → Site settings → Pop-ups → Newsletter

# First admin account: used once by `php artisan migrate --seed`, then DELETE the password line
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
GA4_MEASUREMENT_ID=
GOOGLE_PLACES_API_KEY=          # Google reviews; restrict the key to the Places API (New) in Google Cloud
