# =============================================================================
#  Safety net for the PROJECT ROOT (itsn-laravel/).
#  Normally the domain's document root points at itsn-laravel/public and this
#  file only matters if the whole project ends up inside public_html: it then
#  sends every request into public/ so .env, vendor/, storage/ stay private.
#
#  Note: Apache/LiteSpeed also apply this file to everything BELOW it (public/
#  included), so it only blocks exact file names, never whole file types.
# =============================================================================
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow SSL certificate validation
    RewriteRule ^\.well-known/ - [L]

    # Everything else goes through public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Secrets and project files that must never be served from anywhere
<FilesMatch "^\.env|\.(log|sql|sqlite)$|^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
